              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Budi Santoso\",\n  \"phone\": \"+6281234567890\",\n  \"bio\": \"Pemilik UMKM kopi asal Bandung\",\n  \"location\": \"Bandung\",\n  \"party\": {\n    \"name\": \"Kopi Nusantara\",\n    \"isCompany\": true,\n    \"description\": \"Supplier biji kopi arabika kualitas ekspor\",\n    \"location\": \"Bandung\",\n    \"npwp\": \"01.234.567.8-901.000\",\n    \"nib\": \"1234567890123\"\n  },\n  \"businessRoles\": [\n    \"SUPPLIER\"\n  ],\n  \"capabilityNames\": [\n    \"kopi-arabika\",\n    \"ekspor\"\n  ]\n}",
