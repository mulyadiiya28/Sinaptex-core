      "name": "00 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{healthUrl}}",
              "host": [
                "{{healthUrl}}"
              ]
            },
            "description": "Cek koneksi API + DB (SELECT 1). Return 503 kalau DB bermasalah."
          },
          "response": []
        }
      ]
