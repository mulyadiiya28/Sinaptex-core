  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "healthUrl",
      "value": "http://localhost:4000/api/health",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Supabase access_token, didapat dari sign-in di client (bukan dibuat API ini)"
    },
    {
      "key": "partyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "counterpartyId",
      "value": "",
      "type": "string",
      "description": "partyId lawan transaksi, untuk testing matching"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "opportunityId",
      "value": "",
      "type": "string",
      "description": "Opportunity NEED milik sendiri"
    },
    {
      "key": "counterOpportunityId",
      "value": "",
      "type": "string",
      "description": "Opportunity OFFER milik party lain (hasil matching)"
    },
    {
      "key": "matchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invitationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "dealId",
      "value": "",
      "type": "string"
    },
    {
      "key": "profileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationDocumentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fraudFlagId",
      "value": "",
      "type": "string"
    },
    {
      "key": "inquiryId",
      "value": "",
      "type": "string"
