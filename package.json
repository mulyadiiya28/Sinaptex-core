{
  "name": "sinaptex",
  "version": "1.0.0",
  "description": "Sinaptex API — Express + Prisma + Zod + Cloudinary + Supabase",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky || true",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "db:backup": "bash prisma/scripts/backup.sh",
    "db:dump": "node prisma/scripts/dump-essential.js",
    "db:restore": "bash prisma/scripts/restore.sh",
    "worker:party-stats": "node src/queue/partyStats.worker.js",
    "worker:notification": "node src/queue/notification.worker.js",
    "scheduler": "node src/jobs/scheduler.js",
    "jobs:once": "node src/jobs/run-once.js",
    "jobs:frequent": "node src/jobs/run-once.js --group=frequent",
    "jobs:daily": "node src/jobs/run-once.js --group=daily"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "cloudinary": "^2.4.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eventemitter2": "^6.4.9",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.6",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.7.5",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "lint-staged": "^15.2.9",
    "prisma": "5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
